    // -------------------------------------------------- double signature

    function _header(Unit memory u) internal pure returns (UnitHeader memory h) {
        h.pid = u.pid;
        h.epoch = u.epoch;
        h.count = u.count;
        h.unitNo = u.unitNo;
        h.first = u.first;
        h.last = u.last;
        h.root = u.root;
        h.root0 = u.root0;
        h.snapshotHash = keccak256(abi.encode(u.snapshot));
    }

    /// The header's fields are all static, so abi.encode of the struct is
    /// the field-by-field encoding.
    function _signHeader(uint256 key, UnitHeader memory h) internal returns (bytes memory) {
        bytes32 th = f.UNIT_TYPEHASH();
        bytes32 sh = keccak256(abi.encode(th, h));
        return _sig(key, _typed(f.DOMAIN_SEPARATOR(), sh));
    }

