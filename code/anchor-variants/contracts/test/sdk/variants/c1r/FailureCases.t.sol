        _settleReverts(pid2, SettlementBaseV.Bond.selector);
        token.mint(address(this), CAP);
        token.approve(address(f), CAP);
        f.depositBond(s2, CAP - 1); // anyone may add
        _settleReverts(pid2, SettlementBaseV.Bond.selector);
        token.mint(address(this), 1);
        f.depositBond(s2, 1);
        Auth memory a = _auth(pid2, PRICE, keccak256("ok"));
        f.settle(a, _authSig(a), 0, 0, 0);
    }

    // ------------------------------------------------------- swap timing

    function test_swapProofAcceptedUntilCursorPasses() public {
        Receipt memory r = _buy(pidP, _rs(pidP, 0, PRICE), 0);
        bytes32 ch = m.profile(pidP).codeHash;
        bytes memory rsSig = _sig(sellerKey, _typed(f.DOMAIN_SEPARATOR(), _rsHash(pidP, ch, r)));
        Leaf[] memory ls = new Leaf[](1);
        ls[0].rs = abi.decode(abi.encode(r), (Receipt));
        ls[0].rs.responseHash = keccak256("swapped response");
        _anchor(pidP, ls);
        Opening memory o = _opening(pidP, ls, 0);
        uint256 id = vm.snapshotState();
        vm.roll(f.signDeadlineEnd(epoch) + 10); // after W_e, cursor not passed
        _proveSwapV(o, r, rsSig);
        require(_acct().failures == 1, "accepted after W_e");
        vm.expectRevert(SettlementBaseV.Duplicate.selector);
        _proveSwapV(o, r, rsSig);
        vm.revertToState(id);
        vm.roll(f.anchorDeadline(epoch) + f.T_C() + 1);
        m.release(seller); // the unproved sampled sale fails here
        vm.expectRevert(SettlementBaseV.Timing.selector);
        _proveSwapV(o, r, rsSig);
    }
}
