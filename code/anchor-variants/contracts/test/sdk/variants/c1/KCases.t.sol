        if (kind != UNSIGNED) l.sigB = _ack(pid, l.rs, false);
    }

    /// The leaves of `pid` among `ls` (planned as `plan`), sorted.
    function _leavesOf(bytes32 pid, Plan[] memory plan, Leaf[] memory ls) internal pure returns (Leaf[] memory out) {
        uint256 n;
        for (uint256 i; i < plan.length; i++) if (plan[i].pid == pid) n++;
