    // ================================================ (c) response deadline

    /// Block numbers: the sale settles at s; anchoring and opening happen at
    /// B = last block + d_inc + 1. A profile with r_dl = B - s accepts an
    /// answer in block B, one with r_dl = B - s - 1 does not.
    function _deadlineProfiles() internal returns (bytes32 on, bytes32 late, uint256 s, uint256 b) {
        s = block.number;
        b = f.lastBlock(epoch) + f.D_INC() + 1;
        on = _register(address(lazer), 0, uint32(b - s), 902, 1);
        late = _register(address(lazer), 0, uint32(b - s - 1), 903, 1);
    }

    function test_deadlineBoundaryAnswerAtLastBlockCounts() public {
        (bytes32 on,,,) = _deadlineProfiles();
        (Leaf[] memory ls, Ct memory c) = _sale(on, false, true);
        bytes32 n = ls[0].rs.nonce;
        _open(buyer, on, ls, 1, "", 0);
        require(block.number == m.sale(on, n).settledBlock + m.profile(on).responseDeadline, "at the boundary");
        m.answerDeliver(on, n, c.ct, c.k);
        require(m.dispute(on, n, 1, 1).state == f.D_ANSWERED(), "answer in block eta + r_dl delivers");
        vm.roll(block.number + f.T_X() + 1);
        require(!m.closeDispute(on, n, 1, 1), "no refund");
    }

