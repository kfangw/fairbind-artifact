    /// Dispute window: the last block A_e + T_c opens, the next does not.
    function test_disputeWindowLastBlock() public {
        (Leaf[] memory ls,) = _sale(pidP, false, true);
        uint256 last = f.anchorDeadline(epoch) + f.T_C();
        uint256 id = vm.snapshotState();
        vm.roll(last);
        _open(buyer, pidP, ls, 1, "", 0);
        require(m.dispute(pidP, ls[0].rs.nonce, 1, 1).state == f.D_OPEN(), "opened in the last block");
        vm.revertToState(id);
        vm.roll(last + 1);
        Opening memory o = _opening(pidP, ls, 0);
        vm.prank(buyer);
        vm.expectRevert(SettlementBaseV.Timing.selector);
        _openDisputeV(o, 1, "", 0);
    }

    /// Seller answer window T_d: answering in the last block works and
    /// closing in that block does not; one block later the answer is refused
    /// and closing refunds. Decryption challenge window T_x likewise.
    function test_answerAndChallengeWindowBoundaries() public {
        (Leaf[] memory ls, Ct memory c) = _sale(pidP, false, false);
        bytes32 n = ls[0].rs.nonce;
        _open(buyer, pidP, ls, 1, "", 0);
        uint256 opened = block.number;
        uint256 id = vm.snapshotState();

        vm.roll(opened + f.T_D()); // last block to answer
        vm.expectRevert(SettlementBaseV.State.selector);
        m.closeDispute(pidP, n, 1, 1); // not yet closable
        m.answerDeliver(pidP, n, c.ct, c.k);
        uint256 ans = block.number;
        vm.roll(ans + f.T_X()); // last block to challenge
        require(m.challengeDecrypt(pidP, n, 1, 1, c.ct, 0), "challenge in the last block");
        vm.expectRevert(SettlementBaseV.State.selector);
        m.closeDispute(pidP, n, 1, 1);
        vm.roll(ans + f.T_X() + 1);
        require(m.closeDispute(pidP, n, 1, 1), "refund after the window");

        vm.revertToState(id);
        vm.roll(opened + f.T_D() + 1);
        vm.expectRevert(SettlementBaseV.State.selector);
        m.answerDeliver(pidP, n, c.ct, c.k);
        require(m.closeDispute(pidP, n, 1, 1), "closable one block later");
    }
