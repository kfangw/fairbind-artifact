    // ============================================ (e) last block of windows

    /// Proof in the last block of the proof window passes, the next block is
    /// rejected.
    function test_proofLastBlockPassesNextRejected() public {
        uint64 ts = VALID_AFTER * 1e6; // the fixed tier 1a verifier takes ts = validAfter x 10^6
        bytes32 psi = keccak256("psi r");
        bytes memory m = abi.encodePacked(psi, _lazerUpdate(ts, 7, FEED, feedKey));
        Receipt memory r = _rs(pidP, 0, PRICE);
        r.responseHash = keccak256(abi.encodePacked(TAG, psi, abi.encode(FEED, int64(7), ts)));
        r.materialCommit = keccak256(m);
        Leaf[] memory ls = new Leaf[](1);
        ls[0].rs = _buy(pidP, r, 0);
        _anchor(pidP, ls);
        uint256 last = f.valueDeadline(epoch) + f.T_P();
        uint256 id = vm.snapshotState();

        vm.roll(last);
        _proveV(_opening(pidP, ls, 0), m);
        require(f.passed(keccak256(abi.encode(pidP, ls[0].rs.nonce))), "last block passes");

        vm.revertToState(id);
        vm.roll(last + 1);
        Opening memory o = _opening(pidP, ls, 0);
        vm.expectRevert(SettlementBaseV.Timing.selector);
        _proveV(o, m);
    }

