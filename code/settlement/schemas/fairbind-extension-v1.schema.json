{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbind:x402:extension:v1",
  "title": "FairBind x402 Extension Information Version 1",
  "description": "Information advertised by a FairBind resource server and echoed by a buyer in an x402 version 2 payment payload.",
  "type": "object",
  "required": [
    "version",
    "contract",
    "sellerId",
    "profileId",
    "bondId",
    "serviceClass",
    "predicateId",
    "canonId",
    "claimsHash",
    "profileHash",
    "canonicalHeaders",
    "quotedAtBlock",
    "remaining",
    "responseBlocks",
    "claimBlocks",
    "maxRequestBytes",
    "maxResponseBytes",
    "retentionBlocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "contract": {
      "$ref": "#/$defs/address"
    },
    "sellerId": {
      "$ref": "#/$defs/uint32"
    },
    "profileId": {
      "$ref": "#/$defs/uint32"
    },
    "bondId": {
      "$ref": "#/$defs/uint32"
    },
    "serviceClass": {
      "enum": [
        "data-api",
        "open-weights-inference"
      ]
    },
    "predicateId": {
      "$ref": "#/$defs/bytes32"
    },
    "canonId": {
      "$ref": "#/$defs/bytes32"
    },
    "claimsHash": {
      "$ref": "#/$defs/bytes32"
    },
    "profileHash": {
      "$ref": "#/$defs/bytes32"
    },
    "canonicalHeaders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
      },
      "uniqueItems": true
    },
    "quotedAtBlock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining": {
      "$ref": "#/$defs/uint32"
    },
    "responseBlocks": {
      "$ref": "#/$defs/uint32"
    },
    "claimBlocks": {
      "$ref": "#/$defs/uint32"
    },
    "maxResponseBytes": {
      "$ref": "#/$defs/uint32"
    },
    "maxRequestBytes": {
      "$ref": "#/$defs/uint32"
    },
    "retentionBlocks": {
      "$ref": "#/$defs/uint32"
    },
    "idempotencyKey": {
      "description": "Buyer-supplied 16-byte key. The server does not advertise this field.",
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{32}$"
    },
    "requestHash": {
      "description": "Buyer-supplied normalized request hash. The server does not advertise this field.",
      "$ref": "#/$defs/bytes32"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
