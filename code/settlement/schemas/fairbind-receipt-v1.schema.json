{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbind:receipt:v1",
  "title": "FairBind Seller Receipt Version 1",
  "type": "object",
  "required": [
    "version",
    "chainId",
    "contractAddress",
    "sellerId",
    "profileId",
    "nonce",
    "requestHash",
    "responseHash",
    "claimsHash",
    "predicateCommitment",
    "epoch",
    "issuedAt",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "chainId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "contractAddress": {
      "$ref": "#/$defs/address"
    },
    "sellerId": {
      "$ref": "#/$defs/uint32"
    },
    "profileId": {
      "$ref": "#/$defs/uint32"
    },
    "nonce": {
      "$ref": "#/$defs/bytes32"
    },
    "requestHash": {
      "$ref": "#/$defs/bytes32"
    },
    "responseHash": {
      "$ref": "#/$defs/bytes32"
    },
    "claimsHash": {
      "$ref": "#/$defs/bytes32"
    },
    "predicateCommitment": {
      "$ref": "#/$defs/bytes32"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
