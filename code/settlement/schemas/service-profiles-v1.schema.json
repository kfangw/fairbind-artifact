{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairbind:service-profiles:v1",
  "title": "FairBind Service Profile Set Version 1",
  "type": "object",
  "required": ["formatVersion", "status", "deployment", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "status": { "enum": ["evaluation-only", "production"] },
    "deployment": {
      "type": "object",
      "required": [
        "chainId",
        "contractAddress",
        "tokenAddress",
        "tokenDecimals",
        "securityClaims"
      ],
      "properties": {
        "chainId": { "$ref": "#/$defs/uintString" },
        "contractAddress": { "$ref": "#/$defs/address" },
        "tokenAddress": { "$ref": "#/$defs/address" },
        "tokenDecimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "securityClaims": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "uintString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "uint16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "uint24": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "deadlineConfig": {
      "type": "object",
      "required": [
        "anchorBlocks",
        "sealBlocks",
        "openBlocks",
        "responseBlocks",
        "claimBlocks",
        "serveBlocks",
        "judgeBlocks",
        "evidenceBlocks",
        "appealBlocks"
      ],
      "properties": {
        "anchorBlocks": { "$ref": "#/$defs/uint32" },
        "sealBlocks": { "$ref": "#/$defs/uint32" },
        "openBlocks": { "$ref": "#/$defs/uint32" },
        "responseBlocks": { "$ref": "#/$defs/uint32" },
        "claimBlocks": { "$ref": "#/$defs/uint32" },
        "serveBlocks": { "$ref": "#/$defs/uint32" },
        "judgeBlocks": { "$ref": "#/$defs/uint32" },
        "evidenceBlocks": { "$ref": "#/$defs/uint32" },
        "appealBlocks": { "$ref": "#/$defs/uint32" }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "required": [
        "classId",
        "predicateId",
        "canonId",
        "canonicalHeaders",
        "epochOrigin",
        "epochBlocks",
        "samplePpm",
        "effectivePpm",
        "recheckPpm",
        "bucketCapacity",
        "refillPpmPerBlock",
        "maxRatePpmPerBlock",
        "enforcementBlocks",
        "deferBlocks",
        "retentionBlocks",
        "maxRequestBytes",
        "maxResponseBytes",
        "maxEvidenceBytes",
        "maxPublicationCost",
        "maxReviewCost",
        "maxPurchaseValue",
        "maxBadGain",
        "sellerPenalty",
        "minVerifierBond",
        "verifierBondCap",
        "verifierLatePenalty",
        "verifierWrongPenalty",
        "disputeDeposit",
        "appealDeposit",
        "verifierExposurePpm",
        "maxAssignments",
        "minVerifiers",
        "strikeLimit",
        "marginBlocks",
        "beaconDelayBlocks",
        "beaconSlackL1Blocks",
        "claimWindowBlocks",
        "failureLimit",
        "failureWindowBlocks",
        "maxInconclusivePpm",
        "inconclusiveWindowBlocks",
        "forfeitVerifierPpm",
        "freezeOnInitialFail",
        "minJudgedCount",
        "bucketCapacityPercentilePpm",
        "deadlineConfig"
      ],
      "properties": {
        "classId": { "enum": [1, 2] },
        "predicateId": { "$ref": "#/$defs/bytes32" },
        "canonId": { "$ref": "#/$defs/bytes32" },
        "canonicalHeaders": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" },
          "uniqueItems": true
        },
        "epochOrigin": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "epochBlocks": { "$ref": "#/$defs/uint32" },
        "samplePpm": { "$ref": "#/$defs/uint32" },
        "effectivePpm": { "$ref": "#/$defs/uint32" },
        "recheckPpm": { "$ref": "#/$defs/uint32" },
        "bucketCapacity": { "$ref": "#/$defs/uint32" },
        "refillPpmPerBlock": { "$ref": "#/$defs/uint32" },
        "maxRatePpmPerBlock": { "$ref": "#/$defs/uint32" },
        "enforcementBlocks": { "$ref": "#/$defs/uint32" },
        "deferBlocks": { "$ref": "#/$defs/uint32" },
        "retentionBlocks": { "$ref": "#/$defs/uint32" },
        "maxRequestBytes": { "$ref": "#/$defs/uint32" },
        "maxResponseBytes": { "$ref": "#/$defs/uint32" },
        "maxEvidenceBytes": { "$ref": "#/$defs/uint32" },
        "maxPublicationCost": { "$ref": "#/$defs/uintString" },
        "maxReviewCost": { "$ref": "#/$defs/uintString" },
        "maxPurchaseValue": { "$ref": "#/$defs/uintString" },
        "maxBadGain": { "$ref": "#/$defs/uintString" },
        "sellerPenalty": { "$ref": "#/$defs/uintString" },
        "minVerifierBond": { "$ref": "#/$defs/uintString" },
        "verifierBondCap": { "$ref": "#/$defs/uintString" },
        "verifierLatePenalty": { "$ref": "#/$defs/uintString" },
        "verifierWrongPenalty": { "$ref": "#/$defs/uintString" },
        "disputeDeposit": { "$ref": "#/$defs/uintString" },
        "appealDeposit": { "$ref": "#/$defs/uintString" },
        "verifierExposurePpm": { "$ref": "#/$defs/uint32" },
        "maxAssignments": { "$ref": "#/$defs/uint16" },
        "minVerifiers": { "$ref": "#/$defs/uint16" },
        "strikeLimit": { "$ref": "#/$defs/uint16" },
        "marginBlocks": { "$ref": "#/$defs/uint32" },
        "beaconDelayBlocks": { "$ref": "#/$defs/uint32" },
        "beaconSlackL1Blocks": { "$ref": "#/$defs/uint32" },
        "claimWindowBlocks": { "$ref": "#/$defs/uint32" },
        "failureLimit": { "$ref": "#/$defs/uint32" },
        "failureWindowBlocks": { "$ref": "#/$defs/uint32" },
        "maxInconclusivePpm": { "$ref": "#/$defs/uint32" },
        "inconclusiveWindowBlocks": { "$ref": "#/$defs/uint32" },
        "forfeitVerifierPpm": { "$ref": "#/$defs/uint32" },
        "freezeOnInitialFail": { "type": "boolean" },
        "minJudgedCount": { "$ref": "#/$defs/uint32" },
        "bucketCapacityPercentilePpm": { "$ref": "#/$defs/uint32" },
        "deadlineConfig": { "$ref": "#/$defs/deadlineConfig" }
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": [
        "assumedHonestWeightPpm",
        "assumedFalseAcceptancePpm",
        "effectivePpmIsMeasured",
        "expectedDetectionCount",
        "postDetectionCount",
        "expectedPenaltyFloor",
        "retentionFloorBlocks",
        "judgmentDelayBlocks",
        "failureLimitBasis",
        "notes"
      ],
      "properties": {
        "assumedHonestWeightPpm": { "$ref": "#/$defs/uint32" },
        "assumedFalseAcceptancePpm": { "$ref": "#/$defs/uint32" },
        "effectivePpmIsMeasured": { "type": "boolean" },
        "expectedDetectionCount": { "$ref": "#/$defs/uint32" },
        "postDetectionCount": { "$ref": "#/$defs/uint32" },
        "expectedPenaltyFloor": { "$ref": "#/$defs/uintString" },
        "retentionFloorBlocks": { "$ref": "#/$defs/uint32" },
        "judgmentDelayBlocks": { "$ref": "#/$defs/uint32" },
        "failureLimitBasis": {
          "type": "object",
          "required": [
            "falseRejectionPpm",
            "honestWeightPpm",
            "convictionCollusionPpm",
            "appealModel",
            "initialWrongFailPpm",
            "wrongFinalFailPpm",
            "settlementBasis",
            "caseHorizonBlocks",
            "settlementsPerWindowBound",
            "expectedJudgedCasesPerWindow",
            "expectedWrongFinalFailsPerWindow",
            "targetWindowProbability",
            "windowProbabilityBound",
            "binomialTailAtLimit",
            "annualTerminalSanctionProbability",
            "derivation",
            "recheckPathIncluded",
            "buyerAppealsEveryPass",
            "tiebreakOnPartyReview",
            "measured"
          ],
          "properties": {
            "falseRejectionPpm": { "$ref": "#/$defs/uint32" },
            "honestWeightPpm": { "$ref": "#/$defs/uint32" },
            "convictionCollusionPpm": { "$ref": "#/$defs/uint32" },
            "appealModel": { "type": "string", "minLength": 1 },
            "initialWrongFailPpm": { "$ref": "#/$defs/uint32" },
            "wrongFinalFailPpm": { "$ref": "#/$defs/uint32" },
            "settlementBasis": { "enum": ["failureWindow+caseHorizon"] },
            "caseHorizonBlocks": { "$ref": "#/$defs/uint32" },
            "settlementsPerWindowBound": { "$ref": "#/$defs/uint32" },
            "expectedJudgedCasesPerWindow": { "$ref": "#/$defs/uint32" },
            "expectedWrongFinalFailsPerWindow": { "type": "string", "minLength": 1 },
            "targetWindowProbability": { "type": "string", "minLength": 1 },
            "windowProbabilityBound": { "type": "string", "minLength": 1 },
            "binomialTailAtLimit": { "type": "string", "minLength": 1 },
            "annualTerminalSanctionProbability": { "type": "string", "minLength": 1 },
            "derivation": { "type": "string", "minLength": 1 },
            "recheckPathIncluded": { "type": "boolean" },
            "buyerAppealsEveryPass": { "type": "boolean" },
            "tiebreakOnPartyReview": { "type": "boolean" },
            "measured": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "conditionalDetectionBoundEstablished": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["name", "profileId", "parameterHash", "parameters", "analysis"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "profileId": { "$ref": "#/$defs/uint32" },
        "parameterHash": { "$ref": "#/$defs/bytes32" },
        "parameters": { "$ref": "#/$defs/parameters" },
        "analysis": { "$ref": "#/$defs/analysis" }
      },
      "additionalProperties": false
    }
  }
}
